//##############################################################################
// DeverinoReAct -- ACDL Specification for the Deverino Agent Harness
//
// Describes the ReAct loop executed by PydanticAI's streaming runtime,
// covering: system prompt construction (SOUL + STATE + context_map + catalog),
// turn-level user input, tool invocation and observation, history truncation,
// and the autonomous goal variant.
//
// Based on: harness_poc/core/pydantic_runtime.py, app_factory.py,
//           goal_runner.py, system_prompts/SOUL.md
//##############################################################################

DeverinoChatLoop[@T]: {
    //##########################################################################
    // Namespace bindings
    //##########################################################################
    Namespace env := {
        user_input:          string     // env.user_input[@T] -- current user message
        retrieved_chunks:    string[]   // env.retrieved_chunks -- from search_documents
        web_results:         string[]   // env.web_results -- from web_search
        codebase_matches:    string[]   // env.codebase_matches -- from semble_search
        tool_results:        string[]   // env.tool_results -- ordered by call sequence
        memory_hits:         string[]   // env.memory_hits -- from read_memory
    }

    Namespace sys := {
        soul_charter:        string     // sys.soul_charter -- SOUL.md, agent identity & principles
        project_id:          string     // sys.project_id -- from harness.yaml project.id
        project_state:       string     // sys.project_state -- durable project-level STATE
        session_state:       string     // sys.session_state -- current session durable STATE
        context_map:         string     // sys.context_map -- PEEK materialized orientation cache
        available_skills:    string     // sys.available_skills -- skill catalog for tool discovery
        tool_policy:         string     // sys.tool_policy -- appended by _with_tool_policy()
        session_id:          string     // sys.session_id -- durable session identifier
        config_llm_provider: string     // sys.config.llm.provider
        config_llm_model:    string     // sys.config.llm.model
        config_retrieval:    bool       // sys.config.retrieval.enabled
    }

    Namespace resp := {
        answer:              string     // resp.answer[@t] -- model text output at turn t
        reasoning:           string     // resp.reasoning[@t] -- model reasoning at turn t
        tool_calls:          string[]   // resp.tool_calls[@t] -- tool invocations at turn t
        observations:        string[]   // resp.observations[@t] -- tool results at turn t
        token_usage:         (int, int, int)  // resp.token_usage[@t] -- (prompt, completion, total)
    }

    //##########################################################################
    // Fragments
    //##########################################################################

    StrFrag SoulCharter: {
        sys.soul_charter
    }

    StrFrag StateBlock: {
        "# Project State"
        sys.project_state
        ""
        "# Current Session State"
        sys.session_state
    }

    StrFrag ContextMapBlock: {
        "--- Context Map ---"
        sys.context_map
        "---"
    }

    StrFrag SkillCatalogBlock: {
        sys.available_skills
    }

    StrFrag ToolPolicyBlock: {
        "## Tool Result Policy"
        "- Successful tool calls return result content directly as plain text."
        "- Failed tool calls are prefixed with `[failed]`."
        "- If a tool returns JSON with `orchestrator_action_required: true`,"
        "  stop and surface the content to the user unchanged."
        "- Do not retry failed tools."
        "- semble_search / web_search: max 2 searches per run, then stop."
        "- Do not make the same tool call with the same arguments more than once."
    }

    RoleFrag ConversationTurn[@t]: {
        // User input at turn t
        If env.user_input[@t] != none {
            U: env.user_input[@t]
        }

        // Model response at turn t (may be text, tool calls, or both)
        If resp.tool_calls[@t] != none {
            A: {
                resp.reasoning[@t]
                ForEach(call: resp.tool_calls[@t]) {
                    ACTION_RECORD(call)
                }
            }
        }
        If resp.answer[@t] != none {
            A: resp.answer[@t]
        }

        // Tool observations at turn t
        If resp.observations[@t] != none {
            ForEach(obs: resp.observations[@t]) {
                U: OBSERVATION_RECORD(obs)
            }
        }
    }

    RoleFrag GoalEvaluationTurn: {
        // The goal runner injects an evaluation request as user content
        // after each ReAct cycle, asking whether the objective is met.
        U: "[evaluate_goal] Is the objective complete?"
        A: GOAL_EVAL_RESPONSE(resp.reasoning[@T], resp.answer[@T])
    }

    //##########################################################################
    // Budget and policy fragments
    //##########################################################################

    StrFrag ToolBudgetBlock: {
        "- Maximum consecutive tool rounds: 10"
        "- semble_search per-run budget: 3 calls"
        "- Per-tool duplicate-call guard: active"
    }

    StrFrag TruncationPolicy: {
        "- chat_history_max_tokens: 24000"
        "- chat_history_recent_turns: 6"
        "- Older turns beyond budget are dropped (no summary injection)"
    }

    //##########################################################################
    // Context assembly (S namespace -- the static/system block)
    //##########################################################################

    S: {
        // Layer 1: Identity charter
        Frag SoulCharter

        // Layer 2: Durable state context
        Frag StateBlock

        // Layer 3: PEEK context map (conditionally present)
        If sys.context_map != none {
            Frag ContextMapBlock
        }

        // Layer 4: Skill catalog for tool discovery
        Frag SkillCatalogBlock

        // Layer 5: Tool policy appended by _with_tool_policy()
        Frag ToolPolicyBlock
        Frag ToolBudgetBlock
        Frag TruncationPolicy
    }

    //##########################################################################
    // Turn history (U namespace -- the conversation turns)
    //##########################################################################

    // Compact recent history: last N turns within token budget
    If @T > 1 {
        ForEach(@t: range(max(1, @T - 6), @T)) {
            Frag ConversationTurn[@t]
        }
    }

    // Current user input
    U: env.user_input[@T]
}

//##############################################################################
// Addendum: DeverinoGoalLoop -- Autonomous goal variant
//
// The goal runner (goal_runner.py) wraps the same ReAct loop inside an
// explicit iteration budget with structured evaluation after each cycle.
// The key difference: state is event-sourced (typed BaseEvent subclasses),
// and the loop terminates when the model says "is_complete = true".
//##############################################################################

DeverinoGoalLoop[@T, $max_iterations]: {
    Namespace env := {
        goal_objective: string       // The original goal
        max_iterations: int          // From --max-iterations CLI arg
        max_tokens: int              // From --max-tokens CLI arg
        max_seconds: int             // From --max-seconds CLI arg
    }

    Namespace sys := {
        // Same as chat loop, plus:
        event_history: string[]      // Typed BaseEvent serializations
        iteration: int               // Current iteration counter
        total_tokens_used: int       // Cumulative token accounting
    }

    Namespace resp := {
        // Same as chat loop, plus:
        is_complete: bool            // resp.is_complete[@t] -- goal evaluation result
        final_answer: string         // resp.final_answer -- terminal output on completion
    }

    StrFrag GoalHeader: {
        "## Objective"
        env.goal_objective
        ""
        "## Budget"
        BUDGET_LINE("- Max iterations: ", env.max_iterations)
        BUDGET_LINE("- Max tokens: ", env.max_tokens)
        BUDGET_LINE("- Max seconds: ", env.max_seconds)
    }

    S: {
        Frag SoulCharter
        Frag StateBlock
        If sys.context_map != none {
            Frag ContextMapBlock
        }
        Frag SkillCatalogBlock
        Frag GoalHeader

        // Tool policy adapted for autonomous execution
        "## Autonomous Loop Policy"
        "- After each tool cycle, you will be asked to evaluate: is the goal complete?"
        "- If is_complete = true, provide a final_answer and the loop ends."
        "- If is_complete = false, continue with the next action."
        "- Do not repeat the same action with the same arguments."
        "- If consecutive tool rounds exceed 10, the loop caps automatically."
    }

    // Full event history, compacted as role-based messages
    If sys.event_history != none {
        ForEach(event: sys.event_history) {
            Frag EventMappedTurn[event]
        }
    }

    // Current iteration evaluation
    U: GOAL_ITERATION_PROMPT(env.goal_objective, sys.iteration)
}

RoleFrag EventMappedTurn[event]: {
    // Maps typed BaseEvent instances to conversation roles:
    //   SkillCalled     -> assistant: "[Action] called tool(...)"
    //   SkillCompleted  -> user: "[Observation from tool -- status] \n content"
    //   LLMTextEmitted  -> user: "[LLM text] \n content"
    //   GoalEvaluated   -> user: "[evaluate_goal: is_complete=bool] reasoning"
    // This mirrors _event_to_message() in goal_runner.py
}

//##############################################################################
// StrFrag catalog: Knowledge skills injected into system context
//##############################################################################

StrFrag SkillCatalogEntry[skill]: {
    sys.skill_name[skill]
    sys.skill_description[skill]
    If sys.skill_parameters[skill] != none {
        SKILL_PARAMS(sys.skill_parameters[skill])
    }
    SKILL_AUTO(sys.skill_auto_invokable[skill])
}

//##############################################################################
// Fact annotations (semantic metadata about the loop behavior)
//##############################################################################

// Fact annotations (semantic metadata about the loop behavior):
//   react_style: streaming_tool_loop
//   framework: pydantic_ai
//   end_strategy: early
//   max_consecutive_tool_rounds: 10
//   history_truncation: drop_oldest
//   tool_call_deduplication: per_run
//   context_assembly: layered_concatenation
//   context_map_provenance: event_sourced_peek
//   event_schema: typed_pydantic_BaseEvent